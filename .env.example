# ==============================================================================
# Tep bien moi truong mau cho du an
# ==============================================================================
# Huong dan: Sao chep tep nay thanh .env va dien gia tri thuc te cua ban
# Tuyet doi khong commit tep .env chua bi mat len GitHub

# --- 1. Cau hinh ung dung chung ---
APP_NAME=my-awesome-app
APP_ENV=development # gia tri: development hoac staging hoac production
PORT=8080
LOG_LEVEL=debug # gia tri: debug hoac info hoac warn hoac error

# --- 2. Co so du lieu va bo nho dem, cap nhat theo docs/techs ---
# Co so du lieu PostgreSQL hoac MySQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_db?sslmode=disable
# Bo nho dem Redis va hang doi
REDIS_URL=redis://localhost:6379/0

# --- 3. Bao mat va xac thuc nguoi dung ---
# Tao chuoi ngau nhien toi thieu 32 ky tu: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- 4. Tich hop mo hinh ngon ngu lon AI ---
# Dich vu Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Dich vu Anthropic Claude API mo rong
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- 5. Dich vu gui thu dien tu tuy chon ---
# Thiet lap may chu SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_smtp_key_here
EMAIL_FROM=noreply@example.com
